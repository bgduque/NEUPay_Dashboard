# Copy to .env.local for local dev, or set these in your hosting platform
# (AWS Amplify Hosting, S3+CloudFront, etc.) at build time.

# Base URL of the NEU Payment backend. Locally, this is the Spring Boot
# server. In production, point at your ALB / api.neu.edu.ph.
VITE_NEU_API_BASE=http://localhost:8080

# Cosmetic: shown in the page title and login screen footer.
VITE_NEU_APP_NAME="NEU Cashier Dashboard"

# Optional: shown to operators on the login screen so they know which
# environment they're in. Use values like "Production", "Staging", "Local".
VITE_NEU_ENV_LABEL="Local"
