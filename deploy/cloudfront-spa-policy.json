{
  "_comment": "CloudFront Function source — rewrites SPA deep-links to /index.html. Attach to the distribution as a viewer-request function. The actual function code lives in spa-rewrite.js next to this file.",
  "BucketPolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AllowCloudFrontOAC",
        "Effect": "Allow",
        "Principal": { "Service": "cloudfront.amazonaws.com" },
        "Action": "s3:GetObject",
        "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME/*",
        "Condition": {
          "StringEquals": {
            "AWS:SourceArn": "arn:aws:cloudfront::REPLACE_ACCOUNT_ID:distribution/REPLACE_DISTRIBUTION_ID"
          }
        }
      }
    ]
  },
  "ResponseHeadersPolicy": {
    "Comment": "Security headers for the NEU Cashier Dashboard",
    "Name": "neu-cashier-fe-headers",
    "SecurityHeadersConfig": {
      "StrictTransportSecurity": {
        "Override": true,
        "AccessControlMaxAgeSec": 31536000,
        "IncludeSubdomains": true,
        "Preload": false
      },
      "ContentTypeOptions": { "Override": true },
      "FrameOptions": { "Override": true, "FrameOption": "DENY" },
      "ReferrerPolicy": { "Override": true, "ReferrerPolicy": "strict-origin-when-cross-origin" },
      "XSSProtection": { "Override": true, "Protection": true, "ModeBlock": true }
    }
  }
}
